<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:subtitle="@string/settings_hub_toolbar_subtitle"
        app:title="@string/settings_hub_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="40dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_overview_title"
                                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="@string/settings_overview_summary"
                                android:textAppearance="?attr/textAppearanceBodyMedium" />
                        </LinearLayout>

                        <com.google.android.material.chip.Chip
                            android:id="@+id/versionText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:checkable="false"
                            android:clickable="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/storageUsageText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/storage_usage_unavailable"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/storageUsageProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progress="0"
                        app:indicatorTrackGapSize="0dp"
                        app:trackCornerRadius="5dp"
                        app:trackThickness="10dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp"
                        app:singleLine="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/storageStatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="false"
                            android:clickable="false" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/adbStatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="false"
                            android:clickable="false" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/rootStatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="false"
                            android:clickable="false" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingStart="4dp"
                android:paddingBottom="9dp"
                android:text="@string/settings_section_files"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <dev.laxerus.omnifiles.ui.SettingsActionCard
                android:id="@+id/storageAnalyzerButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <dev.laxerus.omnifiles.ui.SettingsActionCard
                android:id="@+id/trashButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <dev.laxerus.omnifiles.ui.SettingsActionCard
                android:id="@+id/checksumButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingStart="4dp"
                android:paddingBottom="9dp"
                android:text="@string/settings_section_adb"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <dev.laxerus.omnifiles.ui.SettingsActionCard
                android:id="@+id/adbCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <dev.laxerus.omnifiles.ui.SettingsActionCard
                android:id="@+id/adbFilesCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <dev.laxerus.omnifiles.ui.SettingsActionCard
                android:id="@+id/saveScoutCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingStart="4dp"
                android:paddingBottom="9dp"
                android:text="@string/settings_section_phone"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <dev.laxerus.omnifiles.ui.SettingsActionCard
                android:id="@+id/storageAccessCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <dev.laxerus.omnifiles.ui.SettingsActionCard
                android:id="@+id/wifiSettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <dev.laxerus.omnifiles.ui.SettingsActionCard
                android:id="@+id/developerSettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <dev.laxerus.omnifiles.ui.SettingsActionCard
                android:id="@+id/appDetailsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingStart="4dp"
                android:paddingBottom="9dp"
                android:text="@string/settings_section_developer"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <dev.laxerus.omnifiles.ui.SettingsActionCard
                android:id="@+id/sqliteStudioCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
